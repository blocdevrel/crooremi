{
  "name": "remifi",
  "version": "0.1.0",
  "private": true,
  "description": "Remifi — hireable USDC payroll & revenue-split agent on Celo (ERC-8021 tagged)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "wallet:create": "tsx scripts/create-agent-wallet.ts",
    "smoke:transfer": "tsx scripts/smoke-tagged-transfer.ts",
    "smoke:x402": "tsx scripts/smoke-x402-hire.ts",
    "8004:register": "tsx scripts/register-8004.ts",
    "8004:set-uri": "tsx scripts/set-agent-uri.ts",
    "contracts:build": "bash -lc 'export PATH=\"$HOME/.foundry/bin:$PATH\"; cd contracts && forge build'",
    "contracts:test": "bash -lc 'export PATH=\"$HOME/.foundry/bin:$PATH\"; cd contracts && forge test -vv'",
    "contracts:sync-abi": "tsx scripts/sync-router-abi.ts",
    "contracts:prepare": "npm run contracts:build && npm run contracts:sync-abi"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@celo/attribution-tags": "^0.3.0",
    "@prisma/client": "^6.9.0",
    "next": "^15.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.31.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.23",
    "prisma": "^6.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
