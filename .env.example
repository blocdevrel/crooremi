# A2A / journey scripts (TEST_RECIPIENT_* required for npm run journey / a2a:*)
# TEST_RECIPIENT_A=0x...
# TEST_RECIPIENT_B=0x...
# TEST_ENS_NAME=example.base.eth
# CROO_REQUESTER_SDK_KEY=
# CROO_THIRD_AGENT_SDK_KEY=
# CROO_HIRE_SDK_KEY=
# Comma-separated requester SDK keys for npm run a2a:instant-rotate
# CROO_HIRE_SDK_KEYS=croo_sk_...,croo_sk_...
# CROO_POLICY_AGENT_SDK_KEY=
# CROO_EXECUTOR_AGENT_SDK_KEY=
# A2A_HIRE_SERVICE=createPolicy
# A2A_FUND_AMOUNT=100000
# PROVIDER_AA_WALLET_ADDRESS=

BASE_RPC_URL=https://mainnet.base.org
ETH_RPC_URL=https://ethereum.publicnode.com
BASE_CHAIN_ID=8453
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

ENS_REGISTRAR_PRIVATE_KEY=

# Router on Base — CAP providerFundAddress for executePaymentJob
# ROUTER_ADDRESS=
# ROUTER_EXECUTOR_ADDRESS=          # must match on-chain executor / payout wallet
# ABI: npm run contracts:prepare → src/chain/abi/router.json

# Signs router.executeSplit + EOA fallback transfers
# PROVIDER_PAYOUT_PRIVATE_KEY=

# Skip on-chain USDC transfers in local tests
# DEV_MOCK_PAYROLL_SETTLEMENT=true
ENS_AUTO_REGISTER_PARENT=true
ENS_REGISTRATION_YEARS=1
DEV_MOCK_ENS_SUBNAMES=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Policy store — Neon Postgres (required on Railway production)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Local file fallback only when DATABASE_URL is unset
# REMIFI_POLICY_DIR=/app/data/policies
